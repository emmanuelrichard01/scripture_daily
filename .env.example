# ─── Client (exposed to the browser — must be publishable values only) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# VAPID *public* key for Web Push. Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ─── Server only (Vercel env vars — NEVER commit real values) ───
# Private half of the VAPID keypair above.
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact address embedded in push requests, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com
# Supabase service-role key — bypasses RLS. Required by the reminder cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared secret Vercel Cron sends as `Authorization: Bearer <secret>`
CRON_SECRET=generate-a-long-random-string
